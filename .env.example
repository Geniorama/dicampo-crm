# ─────────────────────────────────────────────────────────────
# CRM Dicampo — plantilla de variables de entorno
# Copiar a .env (desarrollo) y cargar en Netlify (producción).
# NUNCA versionar el archivo con valores reales.
# ─────────────────────────────────────────────────────────────

# ── Base de datos (Supabase) ─────────────────────────────────
# DATABASE_URL: pooler en modo transacción, puerto 6543. Lo usa la app en
# runtime; es lo correcto para funciones serverless de Netlify.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL: conexión directa, puerto 5432. Solo la usa el CLI de Prisma
# (migrate, seed, studio); las migraciones no funcionan sobre PgBouncer.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ── Autenticación (Auth.js v5) ───────────────────────────────
# Generar con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET=""
# URL pública de la app. En Netlify se resuelve sola, en local déjala así.
AUTH_URL="http://localhost:3000"
# Auth.js confía en el host detrás del proxy de Cloudflare/Netlify.
AUTH_TRUST_HOST="true"

# ── Semilla inicial ──────────────────────────────────────────
# Credenciales del primer usuario ADMIN que crea `prisma db seed`.
SEED_ADMIN_EMAIL="admin@dicampo.co"
SEED_ADMIN_PASSWORD="cambiar-esta-clave"
SEED_ADMIN_NAME="Administrador Dicampo"

# ── Agente IA de WhatsApp (n8n) ──────────────────────────────
# Llave con la que n8n llama a /api/agente/*, enviada como
# "Authorization: Bearer <llave>". Mínimo 32 caracteres; sin ella se
# rechazan todas las llamadas del agente.
# Generar con: openssl rand -hex 32
AGENTE_API_KEY=""
# Solo durante una rotación: pon aquí la llave vieja, la nueva en
# AGENTE_API_KEY, actualiza n8n y luego vacía esta variable.
AGENTE_API_KEY_ANTERIOR=""

# ── Supabase Storage (multimedia de WhatsApp) ────────────────
# Bucket privado "wa-media". El CRM firma subidas y lecturas; la llave de
# servicio NUNCA va al navegador ni a n8n.
# Supabase → Project Settings → API Keys → service_role (o una secret key).
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# ── Respuestas de asesores por WhatsApp (n8n) ────────────────
# Webhook de n8n que envía por Meta lo que escribe un asesor en
# /conversaciones. Recibe { telefono, texto, conversacionId, asesor } con el
# encabezado X-CRM-Secret y responde { waMessageId }.
# Generar el secreto con: openssl rand -hex 32
N8N_ENVIO_WEBHOOK_URL=""
N8N_ENVIO_SECRET=""
