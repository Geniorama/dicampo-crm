// CRM Dicampo — esquema de datos
// Pulpa de fruta congelada, venta B2B en Bogotá.
// Convención: enums y valores de negocio en español (coinciden con la operación),
// nombres de modelos y campos en inglés (coinciden con el código).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Usuarios y autenticación (Auth.js v5)
// ─────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  VENDEDOR
  BODEGA
  DESPACHO
  /// Compras: registra la fruta que se compra y su costo. Ve costos; no toca
  /// el inventario de pulpa.
  COMPRAS
  /// Usuario de sistema del agente IA de WhatsApp. No tiene contraseña ni
  /// acceso a la interfaz: entra solo por /api/agente con API key.
  AGENTE_IA
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  phone         String?
  role          UserRole  @default(VENDEDOR)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  ownedClients   Client[]          @relation("ClientOwner")
  opportunities  Opportunity[]
  activities     Activity[]
  soldOrders     Order[]           @relation("OrderSeller")
  quotes         Quote[]           @relation("QuoteSeller")
  salesGoals     SalesGoal[]
  purchases      FruitPurchase[]
  payments       Payment[]
  batches        ProductionBatch[]
  drivenRoutes   DeliveryRoute[]   @relation("RouteDriver")
  stockMovements StockMovement[]

  assignedConversations WhatsappConversation[] @relation("ConversationAssignee")
  authoredMessages      WhatsappMessage[]      @relation("MessageAuthorUser")

  visitSchedule AdvisorSchedule?

  @@index([role, active])
}

// Modelos requeridos por @auth/prisma-adapter. El MVP usa el proveedor
// Credentials con sesión JWT, pero quedan listos para añadir OAuth después.

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────
// Clientes (B2B: restaurantes, fruterías, panaderías…)
// ─────────────────────────────────────────────────────────────

enum ClientType {
  RESTAURANTE
  FRUTERIA
  PANADERIA
  COMIDAS_RAPIDAS
  CAFETERIA
  HOTEL
  DISTRIBUIDOR
  OTRO
}

enum ClientStatus {
  PROSPECTO
  ACTIVO
  INACTIVO
  SUSPENDIDO
}

enum PaymentTerms {
  CONTADO
  CREDITO_8
  CREDITO_15
  CREDITO_30
}

/// Cómo se documenta la venta: factura electrónica o remisión.
enum BillingMode {
  FACTURA
  REMISION
}

enum DocType {
  CC
  CE
  NIT
  PASAPORTE
}

model Client {
  id                  String       @id @default(cuid())
  /// Consecutivo generado por Postgres; se muestra como "CLI-0042".
  /// Delegarlo a una secuencia evita la condición de carrera de contar filas.
  sequence            Int          @unique @default(autoincrement())
  /// Razón social
  businessName        String
  /// Nombre comercial / del establecimiento
  tradeName           String?
  /// NIT sin dígito de verificación
  nit                 String?      @unique
  /// Dígito de verificación del NIT
  nitDv               String?
  type                ClientType   @default(OTRO)
  status              ClientStatus @default(PROSPECTO)
  email               String?
  phone               String?
  ownerId             String?
  priceListId         String?
  paymentTerms        PaymentTerms @default(CONTADO)
  billingMode         BillingMode  @default(FACTURA)
  /// Negociación especial "X-Y" (15-10): X % de descuento en el primer pedido
  /// de cada sede y Y % en los siguientes. Nulo = sin negociación.
  negotiationFirstPct Int?
  negotiationNextPct  Int?
  /// Cupo de crédito aprobado en COP
  creditLimit         Decimal      @default(0) @db.Decimal(14, 2)
  notes               String?      @db.Text
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  owner         User?                  @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  priceList     PriceList?             @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  addresses     ClientAddress[]
  contacts      Contact[]
  opportunities Opportunity[]
  activities    Activity[]
  orders        Order[]
  quotes        Quote[]
  conversations WhatsappConversation[]

  @@index([status, type])
  @@index([ownerId])
  @@index([businessName])
}

model ClientAddress {
  id            String   @id @default(cuid())
  clientId      String
  /// Etiqueta de la sede, p. ej. "Sede Chapinero"
  label         String
  address       String
  neighborhood  String?
  /// Localidad de Bogotá (Engativá, Suba…); es la que agrupa el despacho
  locality      String?
  city          String   @default("Bogotá")
  zoneId        String?
  lat           Float?
  lng           Float?
  /// Indicaciones para el repartidor (horarios, portería, etc.)
  deliveryNotes String?  @db.Text
  isPrimary     Boolean  @default(false)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  zone   DeliveryZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  orders Order[]
  quotes Quote[]

  @@index([clientId])
  @@index([zoneId])
}

model Contact {
  id           String   @id @default(cuid())
  clientId     String
  firstName    String
  lastName     String?
  /// Cargo, p. ej. "Chef", "Administrador"
  jobTitle     String?
  email        String?
  phone        String?
  /// Número de WhatsApp en formato E.164, p. ej. "573107296238"
  whatsapp     String?
  /// `whatsapp` (o `phone` si falta) normalizado con `normalizePhone()`:
  /// "310 729 6238" y "+57 3107296238" quedan iguales. Es la llave con que el
  /// agente de WhatsApp encuentra a un contacto; lo mantiene el servicio.
  whatsappE164 String?
  docType      DocType?
  docNumber    String?
  isPrimary    Boolean  @default(false)
  active       Boolean  @default(true)
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client        Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  activities    Activity[]
  conversations WhatsappConversation[]

  @@index([clientId])
  @@index([whatsappE164])
}

// ─────────────────────────────────────────────────────────────
// Catálogo y precios
// ─────────────────────────────────────────────────────────────

enum ProductCategory {
  PULPA
  LIMONADA
  MEZCLA
  /// Zumos listos, que se venden por litros y no por kilos de pulpa
  ZUMO
}

enum Presentation {
  KILO
  LIBRA
  /// Zumos: 500 ml, 1 L y 3 L
  MEDIO_LITRO
  LITRO
  TRES_LITROS
}

model Product {
  id               String          @id @default(cuid())
  /// Nombre comercial, p. ej. "Pulpa de Mango"
  name             String
  /// Sabor base, p. ej. "Mango". Único: un sabor = un producto.
  flavor           String          @unique
  category         ProductCategory @default(PULPA)
  description      String?         @db.Text
  /// Tarifa de IVA aplicable (0 por defecto: la pulpa de fruta tiene
  /// tratamiento especial en Colombia, Art. 424/477 ET).
  taxRate          Decimal         @default(0) @db.Decimal(5, 4)
  /// Reservado para una imagen del producto. Sin uso: un CRM interno no la
  /// necesita — la foto importa en dicampo.co, donde decide el cliente.
  imageKey         String?
  /// Fruta de la que sale ("Mango", "Limón"): con ella se costea la producción.
  /// Vacío: se usa el sabor.
  baseFruit        String?
  /// Rendimiento esperado al despulpar, en % de los kilos de fruta. Sirve para
  /// avisar cuando una tanda rinde mucho menos de lo normal.
  expectedYieldPct Int?
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  variants ProductVariant[]
  batches  ProductionBatch[]

  @@index([category, active])
}

/// Unidad vendible: un producto en una presentación concreta.
/// Solo existen las combinaciones que Dicampo realmente vende, de modo que
/// un sabor disponible únicamente por kilo simplemente no tiene variante LIBRA.
model ProductVariant {
  id           String       @id @default(cuid())
  productId    String
  sku          String       @unique
  presentation Presentation
  /// Peso neto en gramos (KILO = 1000, LIBRA = 500)
  netWeightG   Int
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceItems     PriceListItem[]
  orderItems     OrderItem[]
  quoteItems     QuoteItem[]
  lots           Lot[]
  stockMovements StockMovement[]

  @@unique([productId, presentation])
  @@index([active])
}

model PriceList {
  id        String    @id @default(cuid())
  name      String    @unique
  /// Lista aplicada a clientes sin lista propia asignada
  isDefault Boolean   @default(false)
  validFrom DateTime?
  validTo   DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  items   PriceListItem[]
  clients Client[]
  quotes  Quote[]
}

model PriceListItem {
  id          String  @id @default(cuid())
  priceListId String
  variantId   String
  /// Precio unitario en COP, sin impuestos
  price       Decimal @db.Decimal(14, 2)
  /// Cantidad mínima para acceder a este precio
  minQty      Decimal @default(1) @db.Decimal(12, 3)

  priceList PriceList      @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([priceListId, variantId, minQty])
  @@index([variantId])
}

// ─────────────────────────────────────────────────────────────
// Pipeline comercial y bitácora
// ─────────────────────────────────────────────────────────────

enum OpportunityStage {
  PROSPECTO
  CONTACTADO
  MUESTRA_ENVIADA
  NEGOCIACION
  GANADA
  PERDIDA
}

model Opportunity {
  id                String           @id @default(cuid())
  clientId          String
  title             String
  stage             OpportunityStage @default(PROSPECTO)
  /// Valor mensual estimado en COP
  estimatedValue    Decimal          @default(0) @db.Decimal(14, 2)
  ownerId           String?
  expectedCloseDate DateTime?
  closedAt          DateTime?
  lostReason        String?
  notes             String?          @db.Text
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  client     Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  owner      User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  activities Activity[]

  @@index([stage, ownerId])
  @@index([clientId])
}

enum ActivityType {
  LLAMADA
  WHATSAPP
  VISITA
  EMAIL
  MUESTRA
  NOTA
}

/// Bitácora de interacciones. Se ancla opcionalmente a un cliente, una
/// oportunidad y/o un pedido; al menos una referencia debe venir informada
/// (lo valida la capa de servicios).
model Activity {
  id            String       @id @default(cuid())
  type          ActivityType
  subject       String
  notes         String?      @db.Text
  userId        String
  clientId      String?
  contactId     String?
  opportunityId String?
  orderId       String?
  /// Fecha compromiso para actividades pendientes
  dueAt         DateTime?
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  order       Order?       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([userId, dueAt])
  @@index([opportunityId])
}

// ─────────────────────────────────────────────────────────────
// Pedidos
// ─────────────────────────────────────────────────────────────

enum OrderStatus {
  BORRADOR
  CONFIRMADO
  EN_PREPARACION
  DESPACHADO
  ENTREGADO
  CANCELADO
}

enum OrderChannel {
  WHATSAPP
  TELEFONO
  VISITA
  WEB
  PRESENCIAL
}

enum PaymentStatus {
  PENDIENTE
  PARCIAL
  PAGADO
}

model Order {
  id                    String        @id @default(cuid())
  /// Consecutivo generado por Postgres; se muestra como "PED-000123"
  orderNumber           Int           @unique @default(autoincrement())
  clientId              String
  addressId             String?
  sellerId              String?
  status                OrderStatus   @default(BORRADOR)
  channel               OrderChannel  @default(WHATSAPP)
  orderDate             DateTime      @default(now())
  requestedDeliveryDate DateTime?
  routeId               String?
  /// Orden de visita dentro de la ruta
  routeSequence         Int?
  subtotal              Decimal       @default(0) @db.Decimal(14, 2)
  discount              Decimal       @default(0) @db.Decimal(14, 2)
  tax                   Decimal       @default(0) @db.Decimal(14, 2)
  total                 Decimal       @default(0) @db.Decimal(14, 2)
  paymentTerms          PaymentTerms  @default(CONTADO)
  paymentStatus         PaymentStatus @default(PENDIENTE)
  notes                 String?       @db.Text
  /// Para el repartidor: qué debe cobrar en la entrega (saldo, efectivo…)
  collectionNote        String?
  /// Para el repartidor: obsequios que lleva este pedido
  giftNote              String?
  /// Momento en que se descontó inventario (idempotencia de la reserva FEFO)
  stockAppliedAt        DateTime?
  confirmedAt           DateTime?
  deliveredAt           DateTime?
  cancelledAt           DateTime?
  cancelReason          String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  client     Client          @relation(fields: [clientId], references: [id])
  address    ClientAddress?  @relation(fields: [addressId], references: [id], onDelete: SetNull)
  seller     User?           @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  route      DeliveryRoute?  @relation(fields: [routeId], references: [id], onDelete: SetNull)
  quote      Quote?
  items      OrderItem[]
  movements  StockMovement[]
  activities Activity[]
  proof      DeliveryProof?
  payments   Payment[]

  @@index([clientId, orderDate])
  @@index([status, orderDate])
  @@index([status, requestedDeliveryDate])
  @@index([sellerId])
  @@index([routeId, routeSequence])
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  OTRO
}

/// Pago recibido de un pedido. Un pedido puede pagarse en varios abonos; el
/// saldo es el total menos la suma de sus pagos, y de ahí sale la cartera.
/// Solo se insertan: un pago mal digitado se corrige con otro que lo compense
/// (el cobro es dinero, no se edita en silencio).
model Payment {
  id        String        @id @default(cuid())
  orderId   String
  amount    Decimal       @db.Decimal(14, 2)
  method    PaymentMethod @default(EFECTIVO)
  /// Fecha en que se recibió el dinero
  paidAt    DateTime      @default(now())
  /// Referencia de la transferencia, recibo, etc.
  reference String?
  userId    String?
  createdAt DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([paidAt])
}

/// Las columnas *Snapshot congelan cómo se vendió el producto: si luego cambia
/// el catálogo o la lista de precios, el histórico del pedido no se altera.
model OrderItem {
  id                   String       @id @default(cuid())
  orderId              String
  variantId            String
  productNameSnapshot  String
  skuSnapshot          String
  presentationSnapshot Presentation
  quantity             Decimal      @db.Decimal(12, 3)
  unitPrice            Decimal      @db.Decimal(14, 2)
  discount             Decimal      @default(0) @db.Decimal(14, 2)
  taxRate              Decimal      @default(0) @db.Decimal(5, 4)
  subtotal             Decimal      @db.Decimal(14, 2)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId])
}

// ─────────────────────────────────────────────────────────────
// Metas comerciales
// ─────────────────────────────────────────────────────────────

/// Meta mensual de ventas (pesos) y de clientes nuevos. Con `userId` es la de
/// un asesor; sin él, la meta general de la empresa. `scopeKey` ("2026-10:id"
/// o "2026-10:GENERAL") garantiza una sola meta por mes y alcance: un índice
/// único sobre `userId` nulo no lo haría, porque Postgres trata cada nulo
/// como distinto.
model SalesGoal {
  id               String   @id @default(cuid())
  /// Mes de la meta, "AAAA-MM"
  month            String
  userId           String?
  scopeKey         String   @unique
  salesTarget      Decimal  @default(0) @db.Decimal(14, 2)
  newClientsTarget Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([month])
}

// ─────────────────────────────────────────────────────────────
// Cotizaciones
// ─────────────────────────────────────────────────────────────

enum QuoteStatus {
  BORRADOR
  ENVIADA
  ACEPTADA
  RECHAZADA
  VENCIDA
}

/// Una cotización es una propuesta de precio: no reserva inventario ni
/// compromete al cliente. Al aceptarla se convierte en un pedido en BORRADOR
/// con los mismos precios (). Como en los pedidos, las líneas guardan
/// snapshots: subir la lista de precios no altera una cotización ya emitida.
model Quote {
  id              String      @id @default(cuid())
  /// Consecutivo de Postgres; se muestra como "COT-000123"
  sequence        Int         @unique @default(autoincrement())
  /// Número que ve el cliente: COT-AAAAMMDD-NNN (consecutivo del día, hora de
  /// Bogotá). Es el mismo formato del cotizador en Excel, que se importa tal cual.
  code            String      @unique
  clientId        String
  addressId       String?
  sellerId        String?
  /// Asesor tal como aparece en el Excel cuando no hay usuario equivalente
  legacySeller    String?
  status          QuoteStatus @default(BORRADOR)
  quoteDate       DateTime    @default(now())
  validUntil      DateTime?
  priceListId     String?
  /// Nombre de la lista aplicada, congelado
  priceListName   String?
  billingMode     BillingMode @default(FACTURA)
  /// Descuento comercial sobre todas las líneas (15 = 15 %)
  discountPercent Decimal     @default(0) @db.Decimal(5, 2)
  /// Motivo visible del descuento, p. ej. "Promo 15% primer pedido"
  discountLabel   String?
  subtotal        Decimal     @default(0) @db.Decimal(14, 2)
  discount        Decimal     @default(0) @db.Decimal(14, 2)
  tax             Decimal     @default(0) @db.Decimal(14, 2)
  total           Decimal     @default(0) @db.Decimal(14, 2)
  notes           String?     @db.Text
  sentAt          DateTime?
  respondedAt     DateTime?
  rejectReason    String?
  orderId         String?     @unique
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  client    Client         @relation(fields: [clientId], references: [id])
  address   ClientAddress? @relation(fields: [addressId], references: [id], onDelete: SetNull)
  seller    User?          @relation("QuoteSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  priceList PriceList?     @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  order     Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  items     QuoteItem[]

  @@index([clientId, quoteDate])
  @@index([status, quoteDate])
  @@index([sellerId, quoteDate])
}

model QuoteItem {
  id                   String       @id @default(cuid())
  quoteId              String
  variantId            String
  productNameSnapshot  String
  skuSnapshot          String
  presentationSnapshot Presentation
  quantity             Decimal      @db.Decimal(12, 3)
  unitPrice            Decimal      @db.Decimal(14, 2)
  discount             Decimal      @default(0) @db.Decimal(14, 2)
  taxRate              Decimal      @default(0) @db.Decimal(5, 4)
  subtotal             Decimal      @db.Decimal(14, 2)

  quote   Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([quoteId])
  @@index([variantId])
}

// ─────────────────────────────────────────────────────────────
// Inventario — producto congelado, trazabilidad por lote obligatoria
// ─────────────────────────────────────────────────────────────

enum LotStatus {
  DISPONIBLE
  AGOTADO
  VENCIDO
  BLOQUEADO
}

model Lot {
  id                String    @id @default(cuid())
  variantId         String
  /// Código de lote de producción, p. ej. "L-20260901-MAN"
  lotCode           String
  productionDate    DateTime
  expiryDate        DateTime
  quantityInitial   Decimal   @db.Decimal(12, 3)
  /// Saldo disponible; lo mantiene inventory.ts dentro de transacción
  quantityAvailable Decimal   @db.Decimal(12, 3)
  status            LotStatus @default(DISPONIBLE)
  notes             String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  variant   ProductVariant   @relation(fields: [variantId], references: [id])
  movements StockMovement[]
  batch     ProductionBatch?

  @@unique([variantId, lotCode])
  // Índice que sostiene la asignación FEFO
  @@index([variantId, status, expiryDate])
  @@index([expiryDate])
}

enum StockMovementType {
  ENTRADA_PRODUCCION
  SALIDA_VENTA
  AJUSTE
  DEVOLUCION
  MERMA
  /// Pulpa entregada como muestra gratis: sale del lote pero no es venta.
  MUESTRA
  /// Devolución que llega dañada: se registra pero no reingresa al lote.
  DEVOLUCION_DANADA
}

/// Kardex de solo inserción: es la auditoría del inventario.
/// `quantity` lleva signo (positivo entra, negativo sale).
model StockMovement {
  id        String            @id @default(cuid())
  type      StockMovementType
  variantId String
  lotId     String?
  quantity  Decimal           @db.Decimal(12, 3)
  orderId   String?
  userId    String?
  reason    String?
  createdAt DateTime          @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id])
  lot     Lot?           @relation(fields: [lotId], references: [id], onDelete: SetNull)
  order   Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  user    User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([orderId])
  @@index([lotId])
}

// ─────────────────────────────────────────────────────────────
// Materia prima y producción
// ─────────────────────────────────────────────────────────────

/// Compra de fruta. Cada compra queda por separado, con fecha, proveedor y
/// precio: dos compras de la misma fruta a distinto precio se ven ambas porque
/// afectan la rentabilidad. No mueve el inventario de pulpa.
model FruitPurchase {
  id        String   @id @default(cuid())
  /// Fecha de calendario de la compra
  date      DateTime @db.Date
  fruit     String
  supplier  String
  kg        Decimal  @db.Decimal(12, 3)
  /// Precio pagado por el lote, sin excipientes
  baseCost  Decimal  @db.Decimal(14, 2)
  /// Costo de materia prima: el del lote más el recargo de excipientes
  cost      Decimal  @db.Decimal(14, 2)
  userId    String?
  notes     String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([fruit, date])
  @@index([date])
}

/// Una tanda de producción: la fruta que entró a despulpar y cómo se repartió.
/// La pulpa pública se vuelve un lote vendible (con FEFO); el granel y el
/// desperdicio solo se contabilizan. `fruitCost` es una foto del costo de la
/// fruta al producir, para que cambiar precios después no reescriba el pasado.
model ProductionBatch {
  id        String   @id @default(cuid())
  productId String
  date      DateTime @db.Date
  fruitKg   Decimal  @db.Decimal(12, 3)
  publicKg  Decimal  @db.Decimal(12, 3)
  bulkKg    Decimal  @db.Decimal(12, 3)
  wasteKg   Decimal  @db.Decimal(12, 3)
  /// Costo de la fruta usada; nulo si no había compras para costearla
  fruitCost Decimal? @db.Decimal(14, 2)
  /// Lote vendible que nació de la pulpa pública
  lotId     String?  @unique
  userId    String?
  notes     String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  lot     Lot?    @relation(fields: [lotId], references: [id], onDelete: SetNull)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, date])
  @@index([date])
}

// ─────────────────────────────────────────────────────────────
// Despacho y entregas (Bogotá)
// ─────────────────────────────────────────────────────────────

model DeliveryZone {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  addresses ClientAddress[]
  routes    DeliveryRoute[]
}

enum RouteStatus {
  PLANEADA
  EN_RUTA
  COMPLETADA
  CANCELADA
}

model DeliveryRoute {
  id        String      @id @default(cuid())
  name      String
  date      DateTime    @db.Date
  zoneId    String?
  driverId  String?
  vehicle   String?
  status    RouteStatus @default(PLANEADA)
  notes     String?     @db.Text
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  zone   DeliveryZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  driver User?         @relation("RouteDriver", fields: [driverId], references: [id], onDelete: SetNull)
  orders Order[]

  @@index([date, status])
  @@index([driverId])
}

/// Evidencia de entrega. Hoy se guarda quién recibió y su documento, que ya
/// es defendible ante un reclamo.
model DeliveryProof {
  id          String   @id @default(cuid())
  orderId     String   @unique
  /// Reservado para la foto de la remisión firmada. Sin uso todavía: se
  /// implementará con Supabase Storage, que ya está aprovisionado, cuando la
  /// operación lo pida.
  photoKey    String?
  receivedBy  String?
  receivedDoc String?
  deliveredAt DateTime @default(now())
  notes       String?  @db.Text

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────
// WhatsApp: conversaciones del agente IA y de los asesores
// ─────────────────────────────────────────────────────────────
//
// n8n escribe aquí a través de /api/agente; la interfaz de supervisión del
// CRM lee lo mismo. Un número de WhatsApp = una conversación: el historial es
// continuo aunque pasen semanas entre mensajes.

enum ConversationStatus {
  /// Responde el agente IA
  BOT
  /// Un asesor tomó la conversación; el agente no responde
  HUMANO
  CERRADA
}

/// Motivo por el que el agente descartó a quien escribió. Un descartado no se
/// crea como cliente: el CRM no se llena de prospectos que no aplican.
enum DisqualificationReason {
  FUERA_DE_COBERTURA
  SIN_NEGOCIO
  OTRO
}

enum MessageDirection {
  ENTRANTE
  SALIENTE
}

enum MessageAuthor {
  CLIENTE
  AGENTE_IA
  ASESOR
}

enum MessageType {
  TEXTO
  AUDIO
  IMAGEN
  DOCUMENTO
  INTERACTIVO
  PLANTILLA
}

model WhatsappConversation {
  id                 String                  @id @default(cuid())
  /// E.164 sin "+", p. ej. "573107296238"
  phone              String                  @unique
  clientId           String?
  contactId          String?
  status             ConversationStatus      @default(BOT)
  /// Vendedor que atiende cuando el estado es HUMANO
  assignedUserId     String?
  /// Aviso de tratamiento de datos entregado (Ley 1581). La política de
  /// Dicampo acepta la conducta inequívoca para atender la solicitud.
  consentAt          DateTime?
  /// Versión de la política vigente cuando se entregó el aviso
  consentVersion     String?
  /// Autorización expresa para comunicaciones comerciales (seguimientos).
  /// Es una finalidad secundaria de la política: sin ella no se hace
  /// seguimiento.
  marketingConsentAt DateTime?
  /// "DEJAR DE RECIBIR MENSAJES" o "CANCELAR": no más seguimientos
  optOutAt           DateTime?
  disqualifiedReason DisqualificationReason?
  disqualifiedAt     DateTime?
  /// Seguimientos enviados (máximo 3: 24 h, 72 h y 5–7 días)
  followUpCount      Int                     @default(0)
  nextFollowUpAt     DateTime?
  /// Último mensaje del cliente: abre la ventana de 24 h de Meta
  lastInboundAt      DateTime?
  lastMessageAt      DateTime?
  /// Resumen que el agente deja para el asesor al escalar
  summary            String?                 @db.Text
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  client       Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  contact      Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedUser User?             @relation("ConversationAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages     WhatsappMessage[]

  @@index([status, lastMessageAt])
  @@index([clientId])
  @@index([assignedUserId])
  @@index([nextFollowUpAt])
}

/// Historial de solo inserción, salvo `deliveryStatus`, que actualizan los
/// webhooks de estado de Meta.
model WhatsappMessage {
  id             String           @id @default(cuid())
  conversationId String
  /// Id de Meta (wamid). Único: deduplica los reintentos del webhook.
  waMessageId    String?          @unique
  direction      MessageDirection
  author         MessageAuthor
  /// Asesor que escribió, cuando `author` es ASESOR
  authorUserId   String?
  type           MessageType      @default(TEXTO)
  body           String?          @db.Text
  /// Ruta en Supabase Storage (bucket privado wa-media)
  mediaPath      String?
  mediaMime      String?
  mediaSizeBytes Int?
  /// sent / delivered / read / failed, según el webhook de estados de Meta
  deliveryStatus String?
  /// Herramientas que usó el agente y fuentes que consultó para responder
  agentTrace     Json?
  createdAt      DateTime         @default(now())

  conversation WhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorUser   User?                @relation("MessageAuthorUser", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Disponibilidad de visitas por asesor
// ─────────────────────────────────────────────────────────────
//
// Las visitas en sí son actividades VISITA con `dueAt` en la agenda del
// asesor (ver services/agent.ts). Aquí vive en qué horario puede hacerlas:
// el agente de WhatsApp solo ofrece y acepta franjas dentro de él. Un asesor
// sin configuración usa el horario general de `VISIT_RULES`
// (lib/visit-schedule.ts). Las horas son minutos desde la medianoche de
// Bogotá: la disponibilidad es hora de pared, no un instante.

model AdvisorSchedule {
  userId        String   @id
  /// Apagado, el agente no le ofrece ni le agenda visitas. Las franjas se
  /// conservan.
  acceptsVisits Boolean  @default(true)
  /// Tiempo que se reserva por visita
  visitMinutes  Int      @default(30)
  /// Traslado que se deja libre entre una visita y la siguiente
  bufferMinutes Int      @default(30)
  /// Días de anticipación mínima: 1 = desde mañana, 0 = desde hoy
  minLeadDays   Int      @default(1)
  /// Hasta cuántos días adelante se puede agendar
  maxDaysAhead  Int      @default(30)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  windows AvailabilityWindow[]
  blocks  AvailabilityBlock[]
}

/// Franja semanal recurrente: "los martes de 8:00 a 12:00".
model AvailabilityWindow {
  id          String @id @default(cuid())
  userId      String
  /// Día ISO: 1 = lunes … 7 = domingo
  weekday     Int
  /// Minutos desde la medianoche de Bogotá (480 = 8:00)
  startMinute Int
  endMinute   Int

  schedule AdvisorSchedule @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, weekday])
}

/// Ausencia puntual del asesor: vacaciones, cita médica, capacitación.
model AvailabilityBlock {
  id        String   @id @default(cuid())
  userId    String
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  createdAt DateTime @default(now())

  schedule AdvisorSchedule @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, endsAt])
}
